{
  "name": "@studently/frontend",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "expo export --platform all",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "admin:css": "tailwindcss -i ./styles/admin.input.css -o ./styles/admin.generated.css && node -e \"const fs=require('fs'); const css=fs.readFileSync('styles/admin.generated.css','utf8'); fs.writeFileSync('styles/adminCssText.ts', 'export const ADMIN_CSS = ' + JSON.stringify(css) + ';\\n');\"",
    "postinstall": "patch-package",
    "test:lifecycle": "node --test tests/listing-lifecycle-copy.test.mjs"
  },
