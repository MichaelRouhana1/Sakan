# Clerk Authentication (required)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional override. On Expo Go + physical device, api.ts auto-uses your Metro LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Mapbox (web maps). Public pk. token. Restrict URLs in the Mapbox dashboard.
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional Studio style. Default: mapbox://styles/mapbox/light-v11
# EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/your-user/your-style-id

# Backend must also have CLERK_SECRET_KEY in backend/.env for protected API routes.
