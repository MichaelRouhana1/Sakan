# Clerk Authentication (required)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional override. On Expo Go + physical device, api.ts auto-uses your Metro LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Mapbox. Public pk. token (runtime). Restrict URLs / bundle IDs in Mapbox dashboard.
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional alias of the same public token:
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# Optional Studio style. Default: mapbox://styles/mapbox/standard
# EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/standard
#
# Native SDK download secret (sk.) — local / EAS only, NEVER EXPO_PUBLIC_*, never commit.
# Needed if prebuild still asks for a downloads token. @rnmapbox/maps 10.x plugin marks it deprecated.
# MAPBOX_DOWNLOADS_TOKEN=sk.eyJ...

# Backend must also have CLERK_SECRET_KEY in backend/.env for protected API routes.
