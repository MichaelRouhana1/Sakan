# Clerk Authentication (required)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional override. On Expo Go + physical device, api.ts auto-uses your Metro LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001

# Google Maps (Android native tiles via react-native-maps). Also set as EAS env/secret
# for cloud Android builds — local .env alone → blank Android map on EAS.
# Restrict by package com.skoun.app + SHA-1 in Google Cloud Console.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Mapbox. Public pk. token (runtime). Used for Directions walking routes (native)
# and mapbox-gl tiles (web). Restrict URLs / bundle IDs in Mapbox dashboard.
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional alias of the same public token:
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# Optional Studio style. Default: mapbox://styles/mapbox/standard
# EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/standard

# Backend must also have CLERK_SECRET_KEY in backend/.env for protected API routes.
