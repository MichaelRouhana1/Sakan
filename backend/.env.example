PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skoun
NODE_ENV=development
ADMIN_API_KEY=change-me-admin-key
# Reachable from phones on your LAN (used in uploaded photo URLs).
# Use your PC's LAN IP — same subnet as Expo Metro (e.g. 192.168.100.2).
PUBLIC_BASE_URL=http://192.168.x.x:3001
UPLOAD_DIR=uploads

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Local DB: from repo root run `npm run db:up` (Docker) then `npm run db:push`.
