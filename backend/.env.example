PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skoun
NODE_ENV=development
ADMIN_API_KEY=change-me-admin-key
PUBLIC_BASE_URL=http://192.168.x.x:3001
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Email / password registration (Resend)
# ---------------------------------------------------------------------------
REGISTRATION_SECRET=change-me-to-a-long-random-secret
RESEND_API_KEY=re_xxxxxxxx
EMAIL_TRANSPORT=auto

# IMPORTANT — Resend recipient rules:
# - With the default test sender `onboarding@resend.dev`, Resend ONLY delivers
#   to the email address of your Resend account. Other recipients get 403.
# - To send OTPs to ANY user email in production:
#   1) Add + verify a domain at https://resend.com/domains (DNS SPF/DKIM)
#   2) Set EMAIL_FROM to an address on that domain, e.g.:
#        EMAIL_FROM=Skoun <no-reply@yourdomain.com>
#   3) Keep RESEND_API_KEY only in backend/.env (never EXPO_PUBLIC_*)
#
# Until a domain is verified, use your Resend-account email for local testing.
EMAIL_FROM=Skoun <onboarding@resend.dev>

# Optional SMTP alternative (Gmail app password, etc.)
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Skoun <you@gmail.com>
