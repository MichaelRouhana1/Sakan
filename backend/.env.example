PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skoun
NODE_ENV=development
ADMIN_API_KEY=change-me-admin-key
# Comma-separated Clerk user ids (user_...) for the web admin console.
# Or set publicMetadata.skounAdmin = true on the Clerk user.
# ADMIN_CLERK_IDS=user_xxx,user_yyy
# Enforce staff gate on /api/admin. Unset = off in development, on in production.
# ADMIN_AUTH_REQUIRED=true
PUBLIC_BASE_URL=http://192.168.x.x:3001
# Expo web origin — Whish (and the local mock) redirect here after checkout.
FRONTEND_PUBLIC_URL=http://localhost:8081
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Whish Pay (credit checkout)
# ---------------------------------------------------------------------------
# auto (default): live when WHISH_CHANNEL + WHISH_SECRET are set, else mock.
# mock: always local checkout page. live: real Whish (creds required).
# Production auto without creds fails at purchase — never mocks.
# WHISH_MODE=auto
# WHISH_CHANNEL=
# WHISH_SECRET=
# WHISH_WEBSITE_URL=https://your-registered-domain
# WHISH_API_BASE_URL=https://lb.sandbox.whish.money/itel-service/api

# ---------------------------------------------------------------------------
# Mapbox Directions (walking routes — server cache)
# ---------------------------------------------------------------------------
# Secret sk. or URL-restricted pk. Never EXPO_PUBLIC_*. Client pk. is tiles only.
# MAPBOX_ACCESS_TOKEN=

# Reverse-proxy hops to trust for req.ip. Unset locally. Production behind nginx/Caddy: 1.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Clerk authentication (required for protected API routes in production)
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Optional — documentation only on backend
# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
